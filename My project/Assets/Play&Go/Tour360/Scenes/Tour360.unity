  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "La Plaza de Espa\xF1a del Real Sitio de San Ildefonso es el umbral urbano
    del conjunto palaciego de La Granja, creado por Felipe V en el siglo XVIII. Abierta
    y empedrada, funciona como vest\xEDbulo entre el caser\xEDo y el Palacio Real,
    desde cuya fachada se accede a los c\xE9lebres jardines barrocos con sus fuentes
    monumentales. A un lado asoma la Real Colegiata de la Sant\xEDsima Trinidad,
    que completa la silueta monumental, y alrededor se disponen edificios hist\xF3ricos
    como la Casa de Oficios, huella del plan cortesano que organiz\xF3 oficios y
    hospedajes al servicio de la residencia real. El arbolado maduro \u2014cedros,
    pinsapos y, en el entorno, sequoias\u2014 aporta sombra y car\xE1cter paisaj\xEDstico
    a un espacio muy frecuentado por visitantes que se orientan aqu\xED antes de
    recorrer el palacio, los jardines o el casco hist\xF3rico. Es un punto de partida
    ideal para obtener informaci\xF3n, fotografiar las perspectivas hacia la Colegiata
    y los parterres, y planificar la visita a las fuentes (conviene comprobar horarios
    de funcionamiento) o combinar el recorrido con la Real F\xE1brica de Cristales,
    pieza clave para comprender el conjunto del Real Sitio"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 0e8b93960873b3d499da01042b905850, type: 2}
  m_sharedMaterial: {fileID: -8579433429008785600, guid: 0e8b93960873b3d499da01042b905850, type: 2}
